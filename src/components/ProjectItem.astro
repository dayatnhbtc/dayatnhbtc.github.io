---
interface Props {
  title: string;
  description: string;
  link: string;
}

const { title, description, link } = Astro.props as Props;
---

<article class="project">
  <h3 class="project-title">
    <a href={link} rel="noopener noreferrer">{title}</a>
  </h3>
  <p class="project-desc">{description}</p>
</article>

